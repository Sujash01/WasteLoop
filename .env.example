# WasteLoop — Environment Variables

# MongoDB Connection String (MongoDB Atlas Cloud or Local MongoDB)
# For MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/wasteloop?retryWrites=true&w=majority
#
# For Local MongoDB:
# MONGODB_URI=mongodb://127.0.0.1:27017/wasteloop
MONGODB_URI=

# Database Name (defaults to 'wasteloop')
MONGODB_DB=wasteloop

# Server Port (defaults to 3000)
PORT=3000
